* text=auto
*.go text eol=lf
*.mod text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
# Files consumed directly by Linux tooling and containers: a CRLF or
# mixed-ending variant is easy to introduce from Windows and only surfaces as a
# container that will not start or a Caddyfile that will not adapt.
Dockerfile text eol=lf
Caddyfile text eol=lf
Caddyfile.static text eol=lf
*.caddyfile text eol=lf
# The Agent embeds the built UI bundle verbatim with go:embed. A CRLF checkout
# on Windows changes those bytes, so its build no longer matches the Linux-built
# release binary; force LF across the UI sources and bundle.
internal/agent/webapp/ui/** text eol=lf
internal/agent/webapp/ui/**/*.woff2 binary
# PowerShell is a Windows-first surface whose tooling is most predictable with
# native CRLF endings.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
