# Optional static compatibility hostname / local health probe hostname.
HOOSHIX_PUBLIC_HOST=gateway.example.com

# Production/default Caddy config uses restricted On-Demand TLS. This URL is owned by the external Control Panel integration and must return 2xx only for currently approved hostnames.
HOOSHIX_TLS_ASK_URL=https://control.example.com/internal/caddy/allow-domain
# Optional explicit static compatibility config: ./Caddyfile.static
HOOSHIX_CADDYFILE=./Caddyfile

# Host ports published by Caddy.
HOOSHIX_HTTP_PORT=80
HOOSHIX_HTTPS_PORT=443

# Read-only external Control Panel metadata projection directory.
HOOSHIX_METADATA_DIR=./runtime/metadata
# Live generation projection is the production/default mode. Use static only for explicit legacy test/migration compatibility.
HOOSHIX_METADATA_MODE=live
HOOSHIX_METADATA_REFRESH_INTERVAL=1s
HOOSHIX_METADATA_MAX_AGE=30s

# Deployment-local CA/server certificate directory created by bootstrap-internal-tls.sh.
HOOSHIX_TLS_DIR=./runtime/tls

# Optional image override. Default builds the local Dockerfile.
HOOSHIX_GATEWAY_IMAGE=hooshix-gateway:local
