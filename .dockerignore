# Build-context hygiene for the Gateway image. The build stage copies the
# tracked checkout (.git included) so `go build -buildvcs=true` can stamp the
# commit and report vcs.modified=false; only the built binary reaches the
# runtime stage. Everything excluded here is untracked/ignored build output,
# so removing it from the context cannot make git report a dirty worktree.

.freebuff
bin
dist
coverage
*.out
*.test
*.exe
deploy/gateway/runtime
internal/agent/webapp/ui/node_modules

# Setup.exe's gitignored embed input (the Agent and tray binaries).
cmd/hooshix-setup/payload

# Local operator scratch and debug output.
server_backup
diag_output.txt
