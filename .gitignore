/bin/
/dist/
/coverage/
*.out
*.test

/deploy/gateway/runtime/
dist/
cmd/hooshix-setup/payload/
/hooshix-agent-tray.exe
/hooshix-setup.exe
/cmd/hooshix-agent-tray/hooshix.ico
/cmd/hooshix-agent-tray/rsrc_windows_*.syso
