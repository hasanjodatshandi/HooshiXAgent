        "resume_nonce": { "$ref": "#/$defs/nonce32" },
        "resume_challenge": { "$ref": "#/$defs/nonce32" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "signature": { "$ref": "#/$defs/signature64" }
      },
      "additionalProperties": false
    },
    "session_resumed": {
      "type": "object",
      "required": ["contract_version", "message_type", "session_id", "next_sequence", "resumed_at", "resume_challenge"],
      "properties": {
        "contract_version": { "const": 1 },
        "message_type": { "const": "session_resumed" },
        "session_id": { "$ref": "#/$defs/id" },
        "next_sequence": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "resumed_at": { "$ref": "#/$defs/timestamp" },
        "resume_challenge": { "$ref": "#/$defs/nonce32" }
      },
