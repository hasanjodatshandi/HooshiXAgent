        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 47 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 94 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 48 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 96 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 49 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 98 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 50 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 100 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 51 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 102 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 52 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 104 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 53 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 106 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 54 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 108 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 55 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 110 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 56 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 112 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 57 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 114 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 58 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 116 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 59 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 118 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 60 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 120 } } } }
      ]
    },
    "ping": {
      "type": "object",
      "required": ["contract_version", "message_type", "ping_id", "sent_at"],
      "properties": {
        "contract_version": { "const": 1 },
        "message_type": { "const": "ping" },
        "ping_id": { "$ref": "#/$defs/id" },
        "sent_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "pong": {
      "type": "object",
      "required": ["contract_version", "message_type", "ping_id", "received_at"],
      "properties": {
        "contract_version": { "const": 1 },
        "message_type": { "const": "pong" },
        "ping_id": { "$ref": "#/$defs/id" },
        "received_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "health_report": {
      "type": "object",
      "required": ["contract_version", "message_type", "report_id", "generated_at", "active_streams", "queued_frames", "reconnect_count"],
      "properties": {
        "contract_version": { "const": 1 },
        "message_type": { "const": "health_report" },
        "report_id": { "$ref": "#/$defs/id" },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "active_streams": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "queued_frames": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "reconnect_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "last_reconnect_at": { "$ref": "#/$defs/timestamp" },
        "agent_version": { "type": "string", "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "stream_open": {
      "type": "object",
      "required": ["contract_version", "message_type", "endpoint_id", "assignment_id", "local_endpoint_id", "request_id"],
      "properties": {
        "contract_version": { "const": 1 },
        "message_type": { "const": "stream_open" },
        "endpoint_id": { "$ref": "#/$defs/id" },
        "assignment_id": { "$ref": "#/$defs/id" },
        "local_endpoint_id": { "$ref": "#/$defs/id" },
        "request_id": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "stream_close": {
      "type": "object",
      "required": ["contract_version", "message_type", "reason_code"],
      "properties": {
        "contract_version": { "const": 1 },
        "message_type": { "const": "stream_close" },
        "reason_code": { "enum": ["completed", "peer_closed", "cancelled"] }
      },
      "additionalProperties": false
    },
    "stream_error": {
      "type": "object",
      "required": ["contract_version", "message_type", "code", "message", "retryable"],
      "properties": {
        "contract_version": { "const": 1 },
        "message_type": { "const": "stream_error" },
        "code": { "enum": ["local_target_unavailable", "route_revoked", "protocol_error", "resource_limit", "internal_error"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "session_revoked": {
      "type": "object",
      "required": ["contract_version", "message_type", "authorization_id", "reason_code"],
      "properties": {
        "contract_version": { "const": 1 },
        "message_type": { "const": "session_revoked" },
        "authorization_id": { "$ref": "#/$defs/id" },
        "reason_code": { "enum": ["disabled", "credential_revoked", "security_hold", "expired"] }
      },
      "additionalProperties": false
    },
    "resume_session": {
      "type": "object",
      "required": ["contract_version", "message_type", "device_id", "authorization_id", "token_id", "session_id", "resume_nonce", "resume_challenge", "issued_at", "signature"],
