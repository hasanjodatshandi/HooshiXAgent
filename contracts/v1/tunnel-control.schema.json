        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 29 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 58 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 30 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 60 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 31 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 62 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 32 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 64 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 33 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 66 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 34 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 68 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 35 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 70 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 36 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 72 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 37 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 74 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 38 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 76 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 39 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 78 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 40 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 80 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 41 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 82 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 42 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 84 } } } },
