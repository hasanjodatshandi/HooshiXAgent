{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hooshix.local/agent/v1/tunnel-control.schema.json",
  "title": "HooshiXAgent Tunnel Control v1",
  "oneOf": [
    { "$ref": "#/$defs/client_hello" },
    { "$ref": "#/$defs/server_challenge" },
    { "$ref": "#/$defs/client_auth" },
    { "$ref": "#/$defs/session_ready" },
    { "$ref": "#/$defs/ping" },
    { "$ref": "#/$defs/pong" },
    { "$ref": "#/$defs/health_report" },
    { "$ref": "#/$defs/stream_open" },
    { "$ref": "#/$defs/stream_close" },
    { "$ref": "#/$defs/stream_error" },
    { "$ref": "#/$defs/session_revoked" },
    { "$ref": "#/$defs/resume_session" },
    { "$ref": "#/$defs/session_resumed" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "nonce32": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "signature64": {
      "type": "string",
      "minLength": 86,
      "maxLength": 86,
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$",
      "description": "RFC3339 UTC with the literal Z suffix, bounded component ranges, and at most 9 fractional digits (nanosecond precision). Maximum length 30."
    },
    "client_hello": {
      "type": "object",
      "required": ["contract_version", "message_type", "device_id", "authorization_id", "token_id", "session_token", "client_nonce"],
      "properties": {
        "contract_version": { "const": 1 },
        "message_type": { "const": "client_hello" },
        "device_id": { "$ref": "#/$defs/id" },
        "authorization_id": { "$ref": "#/$defs/id" },
        "token_id": { "$ref": "#/$defs/id" },
        "session_token": { "type": "string", "minLength": 32, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+$" },
        "client_nonce": { "$ref": "#/$defs/nonce32" }
      },
      "additionalProperties": false
    },
    "server_challenge": {
      "type": "object",
      "required": ["contract_version", "message_type", "session_id", "server_nonce", "expires_at"],
      "properties": {
        "contract_version": { "const": 1 },
        "message_type": { "const": "server_challenge" },
        "session_id": { "$ref": "#/$defs/id" },
        "server_nonce": { "$ref": "#/$defs/nonce32" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "client_auth": {
      "type": "object",
      "required": ["contract_version", "message_type", "session_id", "signature"],
      "properties": {
        "contract_version": { "const": 1 },
        "message_type": { "const": "client_auth" },
        "session_id": { "$ref": "#/$defs/id" },
        "signature": { "$ref": "#/$defs/signature64" }
      },
      "additionalProperties": false
    },
    "session_ready": {
      "$comment": "Cross-field contract rule: idle_timeout_seconds >= 2 * heartbeat_interval_seconds. JSON Schema 2020-12 cannot compare two instance values arithmetically, so the rule is enumerated exactly over heartbeat_interval_seconds 8..60; the values 5..7 are already dominated by the idle_timeout_seconds minimum of 15.",
      "type": "object",
      "required": ["contract_version", "message_type", "session_id", "heartbeat_interval_seconds", "idle_timeout_seconds"],
      "properties": {
        "contract_version": { "const": 1 },
        "message_type": { "const": "session_ready" },
        "session_id": { "$ref": "#/$defs/id" },
        "heartbeat_interval_seconds": { "type": "integer", "minimum": 5, "maximum": 60 },
        "idle_timeout_seconds": { "type": "integer", "minimum": 15, "maximum": 300 },
        "resume_challenge": { "$ref": "#/$defs/nonce32" }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 8 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 16 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 9 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 18 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 10 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 20 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 11 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 22 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 12 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 24 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 13 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 26 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 14 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 28 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 15 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 30 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 16 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 32 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 17 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 34 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 18 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 36 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 19 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 38 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 20 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 40 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 21 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 42 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 22 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 44 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 23 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 46 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 24 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 48 } } } },
        { "if": { "required": ["heartbeat_interval_seconds"], "properties": { "heartbeat_interval_seconds": { "const": 25 } } }, "then": { "properties": { "idle_timeout_seconds": { "minimum": 50 } } } },
