{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hooshix.local/agent/v1/external/revocation-signal.schema.json",
  "title": "HooshiXAgent External Revocation Signal v1",
  "type": "object",
  "required": ["contract_version", "event_id", "subject_kind", "subject_id", "effective_at", "reason_code"],
  "properties": {
    "contract_version": { "const": 1 },
    "event_id": { "$ref": "#/$defs/id" },
    "subject_kind": { "enum": ["device_session_authorization", "endpoint_route_assignment", "device"] },
    "subject_id": { "$ref": "#/$defs/id" },
    "effective_at": { "$ref": "#/$defs/timestamp" },
    "reason_code": { "enum": ["disabled", "credential_revoked", "assignment_revoked", "security_hold", "expired"] }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    }
  }
}
