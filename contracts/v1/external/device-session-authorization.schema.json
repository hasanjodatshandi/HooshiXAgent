{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hooshix.local/agent/v1/external/device-session-authorization.schema.json",
  "title": "HooshiXAgent External Device Session Authorization v1",
  "type": "object",
  "required": [
    "contract_version",
    "authorization_id",
    "device_id",
    "device_public_key",
    "token_id",
    "token_sha256",
    "issued_at",
    "not_before",
    "expires_at",
    "disabled"
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "authorization_id": { "$ref": "#/$defs/id" },
    "device_id": { "$ref": "#/$defs/id" },
    "device_public_key": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "Ed25519 public key: 32 raw bytes, base64url without padding."
    },
    "token_id": { "$ref": "#/$defs/id" },
    "token_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lower-case SHA-256 hex digest of the opaque session token; raw token is not part of this external record."
    },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "not_before": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "disabled": { "type": "boolean" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    }
  }
}
