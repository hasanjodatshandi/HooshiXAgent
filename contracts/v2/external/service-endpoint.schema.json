{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hooshix.local/agent/v2/external/service-endpoint.schema.json",
  "title": "HooshiX service endpoint",
  "type": "object",
  "required": [
    "kind",
    "contract_version",
    "endpoint_id",
    "owner_device_id",
    "protocol",
    "local_endpoint_id",
    "exposure",
    "enabled",
    "created_at",
    "revision"
  ],
  "properties": {
    "kind": { "const": "service_endpoint" },
    "contract_version": { "const": 2 },
    "endpoint_id": { "$ref": "#/$defs/id" },
    "owner_device_id": { "$ref": "#/$defs/id" },
    "protocol": { "type": "string", "enum": ["http", "tcp", "udp"] },
    "application_protocol": {
      "type": "string",
      "enum": ["generic", "rdp"],
      "description": "Optional application policy hint. Omission means generic for backward compatibility; rdp requires tcp and private exposure."
    },
    "local_endpoint_id": {
      "$ref": "#/$defs/id",
      "description": "Opaque Agent-local mapping identifier; never a raw address or URL."
    },
    "public_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "allowed_source_cidrs": {
      "type": "array",
      "description": "Canonical IPv4 network CIDRs allowed to open this public TCP or UDP endpoint.",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 64 }
    },
    "exposure": { "type": "string", "enum": ["private", "public", "both"] },
    "enabled": { "type": "boolean" },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "protocol": { "enum": ["tcp", "udp"] },
          "exposure": { "enum": ["public", "both"] }
        },
        "required": ["protocol", "exposure"]
      },
      "then": { "required": ["public_port", "allowed_source_cidrs"] },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["public_port"] },
            { "required": ["allowed_source_cidrs"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    }
  },
  "additionalProperties": false
}
